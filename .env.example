# Copy to .env.local and fill in. Never commit .env.local.
# Everything defaults to local mocks, so the app runs with no values set at all.

# ---------------------------------------------------------------------------
# Provider selection
# ---------------------------------------------------------------------------
# search: mock | tavily | bing
SEARCH_PROVIDER=mock
# llm: mock | azure-openai | azure-anthropic
LLM_PROVIDER=mock
# email: eml | graph
EMAIL_PROVIDER=eml
# storage: file | azurite | azure
STORAGE_PROVIDER=file

# ---------------------------------------------------------------------------
# Model configuration (used when LLM_PROVIDER is not "mock")
# Two tiers: BULK does scoring and summarising, WRITER does the edition prose.
# ---------------------------------------------------------------------------
AZURE_AI_ENDPOINT=https://<your-foundry-account>.openai.azure.com
AZURE_AI_API_VERSION=2024-10-21
MODEL_BULK=gpt-4.1-mini
MODEL_WRITER=gpt-4.1
# Leave AZURE_AI_API_KEY unset in Azure - managed identity is used instead.
AZURE_AI_API_KEY=

# ---------------------------------------------------------------------------
# Search (used when SEARCH_PROVIDER is not "mock")
# ---------------------------------------------------------------------------
TAVILY_API_KEY=
BING_GROUNDING_ENDPOINT=
BING_GROUNDING_KEY=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Azurite default connection string (only used when STORAGE_PROVIDER=azurite)
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
# Used when STORAGE_PROVIDER=azure
AZURE_STORAGE_ACCOUNT=

# ---------------------------------------------------------------------------
# Email (used when EMAIL_PROVIDER=graph)
# ---------------------------------------------------------------------------
GRAPH_SENDER_ADDRESS=contact@cawt.ai
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=

# ---------------------------------------------------------------------------
# Local server
# ---------------------------------------------------------------------------
API_PORT=7071
# Where the local email sink writes .eml files
OUTBOX_DIR=.outbox
# Hard ceiling on provider spend per calendar month, in USD.
MONTHLY_SPEND_CAP_USD=10
